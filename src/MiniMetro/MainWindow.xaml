<Window x:Class="MiniMetro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="小条节拍器" Icon="app.ico" Width="430" Height="610" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" FontFamily="Microsoft YaHei UI" Foreground="{StaticResource Ink}"
 PreviewKeyDown="OnKeyDown" Closing="OnClosing" SourceInitialized="OnSourceInitialized" MouseWheel="OnWheel"
 PreviewMouseLeftButtonDown="MiniPointerDown" PreviewMouseMove="MiniPointerMove" PreviewMouseLeftButtonUp="MiniPointerUp" LostMouseCapture="MiniCaptureLost">
 <Border Background="#161F30" BorderBrush="#354259" BorderThickness="1" CornerRadius="12">
  <Grid>
   <Grid x:Name="FullPanel" Margin="24,16,24,20">
    <Grid.RowDefinitions>
     <RowDefinition Height="38"/><RowDefinition Height="24"/><RowDefinition Height="125"/><RowDefinition Height="36"/>
     <RowDefinition Height="50"/><RowDefinition Height="74"/><RowDefinition Height="62"/><RowDefinition Height="48"/>
     <RowDefinition Height="48"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border x:Name="TitleDragArea" Grid.Column="0" Background="Transparent" Cursor="SizeAll" ToolTip="按住标题或旁边空白，拖动窗口">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,8,0"/><TextBlock Text="小条节拍器" FontSize="16" FontWeight="SemiBold"/></StackPanel>
     </Border>
     <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="PinButton" Content="置顶" Click="PinClick" ToolTip="让大窗口保持在其他窗口上方" Margin="0,0,6,0" Padding="9,4" FontSize="12"/>
      <Button Content="小条 ↗" Click="MiniClick" ToolTip="缩成 180 × 30 的置顶小横条" Margin="0,0,6,0" Padding="10,4"/>
      <Button Content="—" Click="MinimizeClick" ToolTip="最小化到任务栏" Background="Transparent" Padding="7,4"/>
      <Button Content="×" Click="CloseClick" ToolTip="退出" Background="Transparent" Padding="7,4"/>
     </StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Text="追剧时，节奏也在身边。" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Bottom"/>
    <Grid Grid.Row="2" Margin="0,14,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
     <Button Grid.Column="0" Content="−" FontSize="25" Height="44" Click="MinusClick" ToolTip="减 1 · 按住 Shift 减 5"/>
     <StackPanel Grid.Column="1" HorizontalAlignment="Center">
      <TextBox x:Name="BpmBox" Text="100" Width="168" FontSize="58" FontWeight="Light" TextAlignment="Center" Background="Transparent" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Accent}" BorderThickness="0" Padding="0" MaxLength="3" LostKeyboardFocus="BpmCommit" PreviewKeyDown="BpmKeyDown" ToolTip="输入 20–300，按 Enter 确认"/>
      <TextBlock Text="B P M" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
     </StackPanel>
     <Button Grid.Column="2" Content="+" FontSize="25" Height="44" Click="PlusClick" ToolTip="加 1 · 按住 Shift 加 5"/>
    </Grid>
    <Slider x:Name="TempoSlider" Grid.Row="3" Minimum="20" Maximum="300" TickFrequency="1" IsSnapToTickEnabled="True" Value="100" VerticalAlignment="Center" ValueChanged="TempoChanged" Foreground="{StaticResource Accent}"/>
    <Grid Grid.Row="4" Margin="0,5,0,5">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
     <Button x:Name="PlayButton" Grid.Column="0" Content="▶  开始" Background="{StaticResource Accent}" Foreground="#112A25" FontSize="16" FontWeight="SemiBold" Click="PlayClick" Margin="0,0,10,0"/>
     <Button Grid.Column="1" Content="敲击测速" Click="TapClick" ToolTip="连续敲 3 次以上，自动计算速度"/>
    </Grid>
    <StackPanel Grid.Row="5" VerticalAlignment="Center">
     <StackPanel x:Name="BeatDots" Orientation="Horizontal" HorizontalAlignment="Center"/>
     <TextBlock x:Name="StatusText" Text="准备好就开始" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
    </StackPanel>
    <Grid Grid.Row="6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="每小节拍数" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
      <ComboBox x:Name="BeatsCombo" Height="28" SelectionChanged="PatternChanged"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="每拍细分" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
      <ComboBox x:Name="DivisionCombo" Height="28" SelectionChanged="PatternChanged"/></StackPanel>
    </Grid>
    <Grid Grid.Row="7" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <CheckBox x:Name="AccentCheck" Grid.Column="0" Content="首拍重音" IsChecked="True" Click="OptionsChanged"/>
     <ComboBox x:Name="SoundCombo" Grid.Column="1" Height="28" SelectionChanged="OptionsChanged"/>
    </Grid>
    <Grid Grid.Row="8" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
     <CheckBox x:Name="MuteCheck" Content="静音" Click="OptionsChanged"/>
     <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="65" VerticalAlignment="Center" ValueChanged="OptionsChanged" Margin="5,0,10,0"/>
     <TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="65%" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextAlignment="Right"/>
    </Grid>
    <StackPanel Grid.Row="9" VerticalAlignment="Bottom">
     <TextBlock Text="拖动顶部标题可移动窗口 · 点击「置顶」固定在最前" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,11"/>
     <TextBlock Text="小条：任意位置可拖动 · 滚轮调速 · ↗ 展开" FontSize="11" Foreground="{StaticResource Muted}"/>
     <TextBlock x:Name="HotkeyHint" Text="全局：Ctrl+Alt+空格 开关 · ↑↓ 调速 · M 切换" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
    </StackPanel>
   </Grid>
   <Grid x:Name="MiniPanel" Visibility="Collapsed" Margin="3,1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="27"/><ColumnDefinition Width="23"/><ColumnDefinition Width="48"/><ColumnDefinition Width="23"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="MiniGrip" Grid.Column="0" Background="Transparent" Cursor="SizeAll" ToolTip="小条任意位置均可拖动 · 双击此处展开">
     <TextBlock Text="⠿" Foreground="#68778E" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
    </Border>
    <Button x:Name="MiniPlay" Grid.Column="1" Style="{StaticResource MiniButton}" Content="▶" Foreground="{StaticResource Accent}" Click="PlayClick" ToolTip="单击开始 / 暂停 · 按住拖动"/>
    <Button x:Name="MiniMinus" Grid.Column="2" Style="{StaticResource MiniButton}" Content="−" Click="MinusClick" ToolTip="单击减 1 · Shift 减 5 · 按住拖动"/>
    <Button x:Name="MiniBpm" Grid.Column="3" Style="{StaticResource MiniButton}" Content="100" FontSize="15" FontWeight="SemiBold" Click="MiniBpmClick" ToolTip="单击展开细调 · 按住拖动"/>
    <Button x:Name="MiniPlus" Grid.Column="4" Style="{StaticResource MiniButton}" Content="+" Click="PlusClick" ToolTip="单击加 1 · Shift 加 5 · 按住拖动"/>
    <Button x:Name="MiniExpand" Grid.Column="5" Style="{StaticResource MiniButton}" Content="↗" Click="ExpandClick" ToolTip="单击展开 · 按住拖动"/>
    <Ellipse x:Name="MiniPulse" Grid.Column="6" Width="4" Height="4" Fill="#53637B" VerticalAlignment="Center"/>
    <Grid.ContextMenu><ContextMenu>
     <MenuItem Header="展开细调" Click="ExpandClick"/>
     <MenuItem Header="回到右上角" Click="ResetCornerClick"/>
     <MenuItem x:Name="MiniMuteMenu" Header="静音（保留闪烁）" IsCheckable="True" Click="MiniMuteClick"/>
     <Separator/><MenuItem Header="退出节拍器" Click="CloseClick"/>
    </ContextMenu></Grid.ContextMenu>
   </Grid>
  </Grid>
 </Border>
</Window>
